# 복사해서 .env 로 사용하세요. (application.yml 이 실행 폴더의 .env 를 자동으로 읽습니다)
# 모든 값은 선택이며, 비워두면 아래 기본값이 적용됩니다. 실제 비밀 값은 넣어서 제출하지 마세요.
# (3단계 로그인 기능은 추가 환경변수가 필요 없습니다. 회원 비밀번호는 가입 시 정하고 DB에 BCrypt 해시로만 저장됩니다)
# 같은 이름의 OS 환경변수로 지정해도 됩니다.

# ---- 서버 / 저장소 (1단계) ----
# 서버 포트
PORT=3000

# 방송 메타데이터 DB(H2 파일, vod.mv.db)를 저장할 폴더. 상대 경로는 ./ 로 시작해야 합니다 (H2 규칙)
DATA_DIR=./data

# 업로드한 영상 파일(다시보기, 라이브 녹화본)을 저장할 폴더
UPLOAD_DIR=uploads

# 업로드 최대 크기 (MB). 라이브 녹화본도 이 크기 안에서만 저장됩니다.
MAX_UPLOAD_MB=500

# ---- HTTPS (2단계: 휴대폰 카메라·마이크는 HTTPS 에서만 허용됨) ----
# README "휴대폰 연결 → 방법 A" 의 keytool 명령으로 만든 개발용 인증서를 지정합니다.
SSL_ENABLED=false
SSL_KEYSTORE=certs/dev.p12
# keytool 로 인증서를 만들 때 정한 비밀번호 (예시 값. 실제 쓰는 값은 .env 에만 두고 커밋하지 마세요)
SSL_KEYSTORE_PASSWORD=changeit

# ---- 라이브 (2단계) ----
# 동시 시청자 수 제한 (송출 휴대폰이 시청자마다 직접 영상을 보내는 P2P 구조)
LIVE_MAX_VIEWERS=10
# 송출 화면 연결이 끊긴 뒤 이 시간(초) 안에 돌아오지 않으면 방송을 자동 종료
LIVE_PUBLISHER_GRACE_SECONDS=30

# WebRTC ICE 서버. 같은 Wi-Fi 에서는 STUN 만으로 충분합니다. (쉼표로 여러 개)
STUN_URLS=stun:stun.l.google.com:19302
# 휴대폰 LTE ↔ 다른 망처럼 직접 연결이 막히는 환경에서만 TURN 서버를 지정합니다. (선택)
TURN_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ---- 도네이션 (4단계, 테스트 결제만) ----
# sandbox = 키 없이 쓰는 내장 테스트 PG (기본) / toss = 토스페이먼츠 테스트 모드
PAYMENT_PROVIDER=sandbox
# toss 일 때만: 토스페이먼츠 개발자센터의 "테스트" 키 (test_ 로 시작해야 함. 실제 키는 넣지 말고 .env 는 커밋하지 마세요)
TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=
# 후원 금액 범위(원)
DONATION_MIN_AMOUNT=1000
DONATION_MAX_AMOUNT=500000
